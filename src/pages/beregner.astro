---
// /beregner er slået sammen med /faktisk-materialeliste og findes ikke længere
// som selvstændig side. Denne fil er kun en viderestilling, så gamle links og
// bogmærker stadig virker.
import { href } from '../lib/url';

const maal = href('faktisk-materialeliste');
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <title>Viderestiller til materialelisten …</title>
    <link rel="canonical" href={maal} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${maal}`} />
    <script is:inline define:vars={{ maal }}>window.location.replace(maal);</script>
  </head>
  <body>
    <p>
      Materialelisterne er flyttet. <a href={maal}>Fortsæt til materialelisten</a>.
    </p>
  </body>
</html>

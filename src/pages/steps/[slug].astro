---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VaerktojsListe from '../../components/VaerktojsListe.astro';
import Galleri from '../../components/Galleri.astro';
import StepNav from '../../components/StepNav.astro';
import BestillingsMail from '../../components/BestillingsMail.astro';
import FeedbackLink from '../../components/FeedbackLink.astro';
import materialelister from '../../data/materialelister.json';
import { lister, STORAGE_KEY } from '../../lib/lister';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const steps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
  return steps.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      forrige: i > 0 ? steps[i - 1] : undefined,
      naeste: i < steps.length - 1 ? steps[i + 1] : undefined,
    },
  }));
}

const { entry, forrige, naeste } = Astro.props;
const { Content } = await render(entry);

// Er trinnets materialeliste opdateret med faktiske tal? Ellers "Kommer senere".
const materialerKlar = entry.data.materialerKlar === true;

// Data til "materialer fra din valgte liste": for hver liste kun dette trins
// varer. Klient-scriptet vælger ud fra localStorage, så man kan skifte mellem
// lister (der findes p.t. kun én, men flere kan tilføjes).
const valgtListeConfig = {
  storageKey: STORAGE_KEY,
  materialelisteUrl: href('faktisk-materialeliste'),
  // Første liste bruges som standard, så trinnet viser materialer uden at man
  // først skal vælge en liste. Man kan stadig skifte til en anden.
  defaultListeId: lister[0]?.id ?? '',
  lister: lister.map((l) => ({
    id: l.id,
    navn: l.navn,
    maal: l.maal,
    varer: l.materialerPrTrin[entry.id] ?? [],
  })),
};
const valgtListeJson = JSON.stringify(valgtListeConfig);

// Saml billeder for dette step ud fra mappen src/assets/steps/<slug>/.
const alleBilleder = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/steps/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);

const billeder = Object.entries(alleBilleder)
  .filter(([sti]) => sti.includes(`/steps/${entry.id}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([sti, mod]) => {
    const filnavn = sti.split('/').pop() ?? '';
    const alt = filnavn
      .replace(/\.[^.]+$/, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    return { billede: mod.default, alt: `${entry.data.titel}: ${alt}` };
  });

const naboFor = forrige
  ? { titel: forrige.data.titel, slug: forrige.id, order: forrige.data.order }
  : undefined;
const naboNaeste = naeste
  ? { titel: naeste.data.titel, slug: naeste.id, order: naeste.data.order }
  : undefined;

// Kun trin som FreeCAD-skelettet faktisk modellerer. Tegningerne kopieres
// fra FreeCADs genererede output til public/tegninger/ efter regenerering.
const tegningForTrin: Record<string, { trin: string; noter: string; detaljer: string[] }> = {
  bundrem: {
    trin: 'trin1_bundrem',
    noter: 'Modellens første byggetrin: bundrem og strøer.',
    detaljer: ['bundrem_hjoerne'],
  },
  'spaer-og-regler': {
    trin: 'trin2_vaegregler',
    noter: 'Viser vægreglerne; senere trin i modellen føjer topskinner, gavlregler, spær og gulv til.',
    detaljer: ['regel_front', 'regel_bag'],
  },
  loft: {
    trin: 'trin5_spaer',
    noter: 'Viser modellens rå træskelelet frem til spærene. Loftregler, isolering og loftbeklædning er ikke med i modellen.',
    detaljer: ['gavlregler', 'gavl_top', 'spaer', 'spaer_saede_front', 'spaer_saede_bag'],
  },
  gulv: {
    trin: 'trin6_gulv',
    noter: 'Hele skelettet frem til og med gulv. Trinvisningen er kumulativ.',
    detaljer: ['bundrem_hjoerne'],
  },
};
const tegninger = tegningForTrin[entry.id];
const tegningRod = href('tegninger/6000x3350');
const trinSvg = tegninger ? `${tegningRod}/trin/${tegninger.trin}.svg` : '';
const detaljeSvg = (navn: string) => `${tegningRod}/detaljer/${navn}.svg`;

// Bestillings-mail til savværk – kun på yderbeklædning. Yderbeklædning
// (typisk Douglasgran) kan bestilles direkte hos savværket og skære et
// mellemled væk. Mængderne er vejledende tal for standardhuset – ikke
// rigtige tal fra et konkret byg. Husets mål kommer fra modellen
// (freecad/skelet.py STANDARD), se info.standardHus i materialelister.json;
// det er samme hus som den faktiske materialeliste (id faktisk-600x335).
const erYderbeklaedning = entry.id === 'yderbeklaedning';
let savvaerkEmail: { emne: string; tekst: string } | null = null;
let standardMaal = '';
if (erYderbeklaedning) {
  const standard = materialelister.info.standardHus;
  const meter = (cm: number): string =>
    (cm / 100).toLocaleString('da-DK', { minimumFractionDigits: 1, maximumFractionDigits: 2 });
  standardMaal = `${meter(standard.laengde_cm)} × ${meter(standard.bredde_cm)} m`;
  const standardAreal = standard.areal_m2.toLocaleString('da-DK');
  const talFmt = new Intl.NumberFormat('da-DK', { maximumFractionDigits: 2 });
  const varer = (standard.yderbeklaedning as Array<{ tekst: string; maengde: number; enhed: string; note?: string }>).map(
    (m) => `- ${m.tekst}: ${talFmt.format(m.maengde)} ${m.enhed}${m.note ? ` (${m.note})` : ''}`,
  );
  const linjer = [
    'Hej',
    '',
    'Jeg skal bruge yderbeklædning til et tiny house og vil gerne bestille / bede om tilbud direkte hos jer som savværk – så jeg skærer et mellemled væk.',
    '',
    'Jeg tænker Douglasgran, ubehandlet (gerne kernetræ), som facadebeklædning.',
    '',
    `Huset er standardhuset på ${standardMaal} (${standardAreal} m²).`,
    '',
    `VEJLEDENDE MÆNGDER for ${standardMaal} (se OBS nedenfor):`,
    ...varer,
    '',
    'Ønsker:',
    '- Profil: [fx 1-på-2, klink/faldende eller profilhøvlet]',
    '- Dimension: [fx 25×150 mm]',
    '- Tørhed: [lufttørret / ovntørret]',
    '- Længder: gerne faste længder, der passer til facaden',
    '',
    'OBS: Mængderne ovenfor er vejledende tal for standardhuset – ikke rigtige tal fra et konkret byg. Tilpas til dit eget hus.',
    '',
    'Giv gerne jeres pris pr. m² (og pr. lbm) direkte fra savværk, samt leveringstid og fragt. Jeg indhenter tilbud fra flere savværker (se cc), så jeg kan sammenligne.',
    '',
    'På forhånd tak.',
    '',
    'Med venlig hilsen',
    '__NAVN__',
  ];
  savvaerkEmail = {
    emne: 'Tilbud/bestilling – Douglasgran yderbeklædning (savværk)',
    tekst: linjer.join('\n'),
  };
}
---

<BaseLayout titel={entry.data.titel} beskrivelse={entry.data.resume}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <a
      href={href('#byggesteps')}
      class="text-sm font-medium text-skov-600 hover:text-skov-700">← Alle byggesteps</a
    >

    <header class="mt-4">
      <div class="flex items-center gap-3">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-skov-600 font-bold text-ler-50"
          >{entry.data.order}</span
        >
        <h1 class="text-3xl font-bold text-ler-900 sm:text-4xl">{entry.data.titel}</h1>
      </div>
      <p class="mt-3 text-lg text-ler-700">{entry.data.resume}</p>
      {
        entry.data.tid && (
          <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-ler-100 px-3 py-1 text-sm text-ler-700">
            ⏱️ Estimeret tid: {entry.data.tid}
          </p>
        )
      }
    </header>

    <div class="mt-4">
      <FeedbackLink tekst="Forslag eller fejl i dette trin? Giv feedback" emne={entry.data.titel} />
    </div>

    <section class="prose-tiny mt-8">
      <Content />
    </section>

    <section class="mt-12">
      <h2 class="mb-4 flex items-center gap-2 text-2xl font-bold text-ler-900">
        <span aria-hidden="true">🧱</span> Materialer
      </h2>
      {
        materialerKlar ? (
          <div id="valgt-liste-materialer"></div>
        ) : (
          <div class="rounded-2xl border border-dashed border-ler-300 bg-ler-100/60 p-6 text-center">
            <p class="text-2xl" aria-hidden="true">⏳</p>
            <p class="mt-2 font-semibold text-ler-900">Kommer senere</p>
            <p class="mt-1 text-sm text-ler-700">
              Materialelisten for dette trin er ikke opdateret med faktiske tal endnu.
            </p>
          </div>
        )
      }
    </section>

    {
      erYderbeklaedning && savvaerkEmail && (
        <section id="bestil-savvaerk" class="mt-12 scroll-mt-20 rounded-2xl border border-skov-600/20 bg-skov-600/5 p-6 sm:p-8">
          <h2 class="flex items-center gap-2 text-2xl font-bold text-ler-900">
            <span aria-hidden="true">🪵</span> Bestil direkte hos savværk
          </h2>
          <p class="mt-3 text-ler-700">
            Yderbeklædning kan du med fordel bestille <strong>direkte hos et savværk</strong> og
            skære et mellemled væk – det giver ofte en bedre pris. Typisk vælges{' '}
            <strong>Douglasgran</strong>: holdbart kernetræ, der kan stå ubehandlet og patinere
            smukt gråt.
          </p>

          <div class="mt-5 rounded-xl border border-ler-200 bg-ler-50/70 p-4 text-sm text-ler-700">
            <p class="font-semibold text-ler-900">Sådan bestiller du smart 🪚</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <li>Bestil <strong>direkte hos savværket</strong> – uden mellemled.</li>
              <li>Angiv <strong>profil, dimension, tørhed</strong> og gerne faste længder.</li>
              <li>Send til <strong>flere savværker</strong> og sæt dem i cc, så de ved, der er konkurrence.</li>
              <li>Spørg til <strong>kernetræ</strong> for bedre holdbarhed på ubehandlet facade.</li>
            </ul>
          </div>

          <p class="mt-4 rounded-lg border border-ler-300 bg-ler-100 px-4 py-3 text-sm text-ler-700">
            ⚠️ Mængderne i e-mailen er <strong>vejledende tal for standardhuset på {standardMaal}</strong>
            – <strong>ikke rigtige tal</strong> fra et konkret byg. Tilpas altid til dit eget hus.
          </p>

          <BestillingsMail
            emne={savvaerkEmail.emne}
            tekst={savvaerkEmail.tekst}
            tilPlaceholder="salg@savvaerk.dk"
            ccPlaceholder="info@savvaerk2.dk, kontakt@savvaerk3.dk"
            sendLabel="📧 Åbn bestillings-e-mail"
          />
        </section>
      )
    }

    {
      tegninger && (
        <section class="mt-12" aria-labelledby="tegninger-overskrift">
          <h2 id="tegninger-overskrift" class="mb-2 text-2xl font-bold text-ler-900">📐 Konstruktionstegninger</h2>
          <p class="mb-5 text-ler-700">{tegninger.noter} Mål og snit er vejledende; kontrollér dem mod dit byg før savning.</p>
          <figure class="overflow-hidden rounded-2xl border border-ler-200 bg-white p-3 shadow-sm">
            <img src={trinSvg} alt={`Kumulativ tegning: ${entry.data.titel}`} class="h-auto w-full" loading="lazy" />
            <figcaption class="mt-2 text-sm text-ler-600">Skitse af de modellerede dele til dette byggetrin, genereret fra FreeCAD-modellen.</figcaption>
          </figure>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {tegninger.detaljer.map((detalje) => (
              <figure class="overflow-hidden rounded-2xl border border-ler-200 bg-white p-3 shadow-sm">
                <img src={detaljeSvg(detalje)} alt={`Målsat snittegning: ${detalje.replace(/_/g, ' ')}`} class="h-auto w-full" loading="lazy" />
                <figcaption class="mt-2 text-sm text-ler-600">Målsat detalje fra FreeCAD: {detalje.replace(/_/g, ' ')}. Kontrollér målene før brug.</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold text-ler-900">🔧 Værktøj</h2>
      <VaerktojsListe vaerktoj={entry.data.vaerktoj} />
    </section>

    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold text-ler-900">📷 Billeder</h2>
      <Galleri billeder={billeder} stepTitel={entry.data.titel} />
    </section>

    <StepNav forrige={naboFor} naeste={naboNaeste} />
  </article>

  <script type="application/json" id="valgt-liste-data" set:html={valgtListeJson} />

  <script>
    interface TrinVare {
      tekst: string;
      maengde: number;
      enhed: string;
      note?: string;
    }
    interface ListeData {
      id: string;
      navn: string;
      maal: string;
      varer: TrinVare[];
    }
    interface Config {
      storageKey: string;
      materialelisteUrl: string;
      defaultListeId: string;
      lister: ListeData[];
    }

    const el = document.getElementById('valgt-liste-materialer');
    const cfgEl = document.getElementById('valgt-liste-data');
    if (el && cfgEl) {
      const cfg: Config = JSON.parse(cfgEl.textContent || '{}');

      const talFmt = (n: number): string => n.toLocaleString('da-DK');
      const esc = (s: string): string => {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      };

      const render = (): void => {
        const valgtId = localStorage.getItem(cfg.storageKey);
        // Brug den gemte liste, ellers standardlisten, så trinnet altid viser
        // materialer uden at man først skal vælge en liste.
        const liste =
          cfg.lister.find((l) => l.id === valgtId) ??
          cfg.lister.find((l) => l.id === cfg.defaultListeId) ??
          cfg.lister[0];

        if (!liste) {
          el.innerHTML = `
            <div class="rounded-2xl border border-dashed border-ler-300 bg-ler-100/60 p-6 text-center">
              <p class="text-2xl" aria-hidden="true">📋</p>
              <p class="mt-2 font-semibold text-ler-900">Ingen materialeliste tilgængelig endnu.</p>
              <a href="${cfg.materialelisteUrl}" class="mt-3 inline-block font-semibold text-skov-600 underline">Se materialelister →</a>
            </div>`;
          return;
        }

        const banner = `
          <div class="flex flex-wrap items-center gap-2 rounded-xl border border-skov-600/30 bg-skov-600/10 px-4 py-3 text-sm">
            <span class="font-semibold text-ler-900">Valgt liste:</span>
            <span class="text-ler-800">${esc(liste.navn)}</span>
            <span class="text-ler-500">(${esc(liste.maal)})</span>
            <a href="${cfg.materialelisteUrl}" class="ml-auto font-medium text-skov-600 underline">Skift liste</a>
          </div>`;

        if (!liste.varer.length) {
          el.innerHTML =
            banner +
            `<p class="mt-3 rounded-xl border border-ler-200 bg-ler-50 px-4 py-4 text-sm text-ler-600">Den valgte liste har ingen varer specifikt til dette trin.</p>`;
          return;
        }

        const rows = liste.varer
          .map(
            (v) => `
            <tr class="border-t border-ler-200 align-top">
              <td class="px-4 py-3 font-medium text-ler-900">${esc(v.tekst)}${
                v.note ? `<span class="mt-0.5 block text-xs font-normal text-ler-500">${esc(v.note)}</span>` : ''
              }</td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-ler-700">${talFmt(v.maengde)} ${esc(v.enhed)}</td>
            </tr>`,
          )
          .join('');

        el.innerHTML =
          banner +
          `<div class="mt-3 overflow-x-auto rounded-xl border border-ler-200">
            <table class="w-full border-collapse text-left text-sm">
              <thead class="bg-ler-100 text-ler-800">
                <tr>
                  <th class="px-4 py-3 font-semibold">Vare</th>
                  <th class="whitespace-nowrap px-4 py-3 text-right font-semibold">Antal</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      };

      // Opdater hvis valget ændres i en anden fane.
      window.addEventListener('storage', render);
      render();
    }
  </script>
</BaseLayout>
